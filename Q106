#include <stdio.h>

struct Employee {
    int id;
    char name[50];
    double baseSalary;
    double allowance;
    double tax;
};

int main() {
    int n;
    printf("Enter number of employees: ");
    scanf("%d", &n);
    struct Employee emp[n];

    for(int i = 0; i < n; i++) {
        printf("\nDetails for Employee %d:\n", i + 1);
        printf("ID: "); scanf("%d", &emp[i].id);
        printf("Name: "); scanf("%s", emp[i].name);
        printf("Base Salary: "); scanf("%lf", &emp[i].baseSalary);
        printf("Allowances: "); scanf("%lf", &emp[i].allowance);
        printf("Tax Deductions: "); scanf("%lf", &emp[i].tax);
    }

    printf("\n=== Payroll & Employee Salary Slip ===\n");
    for(int i = 0; i < n; i++) {
        double netSalary = (emp[i].baseSalary + emp[i].allowance) - emp[i].tax;
        printf("ID: %d | Name: %s | Net Salary Pay: $%.2f\n", emp[i].id, emp[i].name, netSalary);
    }
    return 0;
}
