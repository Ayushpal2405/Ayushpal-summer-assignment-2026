#include <stdio.h>

int main() {
    char str[100], result[100];
    int hash[256] = {0};
    int i = 0, j = 0;

    printf("Enter a string: ");
    scanf("%s", str);

    while (str[i] != '\0') {
        if (hash[(unsigned char)str[i]] == 0) {
            hash[(unsigned char)str[i]] = 1; // Mark as seen
            result[j++] = str[i];
        }
        i++;
    }
    result[j] = '\0';

    printf("String after removing duplicates: %s\n", result);
    return 0;
}
