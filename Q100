#include <stdio.h>
#include <string.h>

int main() {
    char words[5][50] = {"Elephant", "Cat", "Banana", "Ox", "Apple"};
    int n = 5;
    char temp[50];

    printf("Before sorting:\n");
    for (int i = 0; i < n; i++) {
        printf("%s (Length: %lu)\n", words[i], strlen(words[i]));
    }

    // Bubble Sort based on length of strings
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (strlen(words[j]) > strlen(words[j + 1])) {
                // Swap the strings
                strcpy(temp, words[j]);
                strcpy(words[j], words[j + 1]);
                strcpy(words[j + 1], temp);
            }
        }
    }

    printf("\nAfter sorting by length:\n");
    for (int i = 0; i < n; i++) {
        printf("%s (Length: %lu)\n", words[i], strlen(words[i]));
    }

    return 0;
}
