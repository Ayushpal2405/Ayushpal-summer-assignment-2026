#include <stdio.h>
#include <string.h>

#define MAX_ITEMS 40

int item_ids[MAX_ITEMS];
char item_names[MAX_ITEMS][50];
int stock_quantities[MAX_ITEMS];
double unit_prices[MAX_ITEMS];
int item_count = 0;

void addNewItem() {
    if (item_count >= MAX_ITEMS) {
        printf("\nWarehouse storage database full.\n");
        return;
    }
    printf("\nEnter Product Code/ID (Integer): ");
    scanf("%d", &item_ids[item_count]);
    getchar();
    
    printf("Enter Product Name: ");
    fgets(item_names[item_count], 50, stdin);
    item_names[item_count][strcspn(item_names[item_count], "\n")] = 0;
    
    printf("Enter Initial Quantity: ");
    scanf("%d", &stock_quantities[item_count]);
    
    printf("Enter Unit Retail Price: ");
    scanf("%lf", &unit_prices[item_count]);
    
    item_count++;
    printf("Inventory stock item saved!\n");
}

void currentStockReport() {
    if (item_count == 0) {
        printf("\nInventory empty.\n");
        return;
    }
    double total_valuation = 0.0;
    printf("\n--- Current Inventory Status Report ---\n");
    printf("%-10s %-20s %-10s %-12s %-12s\n", "Item ID", "Item Name", "Stock Qty", "Unit Price", "Total Value");
    
    for (int i = 0; i < item_count; i++) {
        double item_val = stock_quantities[i] * unit_prices[i];
        total_valuation += item_val;
        printf("%-10d %-20s %-10d $%-11.2f $%-11.2f\n", 
               item_ids[i], item_names[i], stock_quantities[i], unit_prices[i], item_val);
    }
    printf("----------------------------------------------------------------------\n");
    printf("Total Asset Value of Warehouse: $%.2f\n", total_valuation);
}

void updateStockLevels() {
    int id, count, found = 0;
    printf("\nEnter Item ID to restock/dispatch: ");
    scanf("%d", &id);
    
    for (int i = 0; i < item_count; i++) {
        if (item_ids[i] == id) {
            found = 1;
            printf("Current units available: %d. Enter adjustment quantity (use negative to deduct): ", stock_quantities[i]);
            scanf("%d", &count);
            
            if (stock_quantities[i] + count < 0) {
                printf("Error: Insufficient stock level! Cannot complete deduction.\n");
            } else {
                stock_quantities[i] += count;
                printf("Stock configuration modified successfully! New total units: %d\n", stock_quantities[i]);
            }
            break;
        }
    }
    if (!found) printf("Item code not matching system registers.\n");
}

int main() {
    int choice;
    do {
        printf("\n=== Complete Mini Project: Inventory Management ===");
        printf("\n1. Add Inventory Item");
        printf("\n2. Generate Stock Assessment Report");
        printf("\n3. Update Item Quantity");
        printf("\n4. Close Inventory Console");
        printf("\nEnter Selection: ");
        scanf("%d", &choice);
        
        switch (choice) {
            case 1: addNewItem(); break;
            case 2: currentStockReport(); break;
            case 3: updateStockLevels(); break;
            case 4: printf("Shutting down management program...\n"); break;
            default: printf("Selection incorrect.\n");
        }
    } while (choice != 4);
    
    return 0;
}
