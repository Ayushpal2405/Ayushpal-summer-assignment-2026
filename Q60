#include <stdio.h>

void moveZeroesToEnd(int arr[], int size) {
    int count = 0; // Index to track non-zero elements

    // Traverse the array. If element is non-zero, replace the element at index 'count'
    for (int i = 0; i < size; i++) {
        if (arr[i] != 0) {
            arr[count++] = arr[i];
        }
    }

    // Fill the remaining spaces with zeroes
    while (count < size) {
        arr[count++] = 0;
    }
}

int main() {
    int n;
    printf("Enter the number of elements: ");
    scanf("%d", &n);

    int arr[n];
    printf("Enter %d elements:\n", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    moveZeroesToEnd(arr, n);

    printf("Array after moving zeroes to end:\n");
    for (int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    return 0;
}
