#include <stdio.h>
#include <string.h>

int main() {
    char str1[100], str2[100], temp[200] = "";

    printf("Enter original string: ");
    scanf("%s", str1);
    printf("Enter string to check rotation: ");
    scanf("%s", str2);

    if (strlen(str1) != strlen(str2)) {
        printf("The string is NOT a rotation.\n");
    } else {
        // Concatenate str1 with itself (str1 + str1)
        strcpy(temp, str1);
        strcat(temp, str1);

        // Check if str2 is a substring of the combined text
        if (strstr(temp, str2) != NULL) {
            printf("The string IS a rotation.\n");
        } else {
            printf("The string is NOT a rotation.\n");
        }
    }

    return 0;
}
