#include <stdio.h>

int main() {
    int arr1[] = {5, 12, 4, 21, 8};
    int arr2[] = {12, 7, 8, 9, 5};
    int n1 = 5, n2 = 5;

    printf("Common Elements: ");
    for (int i = 0; i < n1; i++) {
        for (int j = 0; j < n2; j++) {
            if (arr1[i] == arr2[j]) {
                printf("%d ", arr1[i]);
                break;
            }
        }
    }
    printf("\n");

    return 0;
}
