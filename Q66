#include <stdio.h>

int main() {
    int arr1[] = {1, 2, 3, 4, 5};
    int arr2[] = {3, 4, 5, 6, 7};
    int n1 = 5, n2 = 5;

    printf("Union of Arrays: ");

    // Print all elements of first array
    for (int i = 0; i < n1; i++) {
        printf("%d ", arr1[i]);
    }

    // Print elements of second array only if not present in first array
    for (int i = 0; i < n2; i++) {
        int isDuplicate = 0;
        for (int j = 0; j < n1; j++) {
            if (arr2[i] == arr1[j]) {
                isDuplicate = 1;
                break;
            }
        }
        if (!isDuplicate) {
            printf("%d ", arr2[i]);
        }
    }
    printf("\n");

    return 0;
}Z
